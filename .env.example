# ── React frontend (CRA reads REACT_APP_* at build time) ─────────────────────

# Base URL of the Java Spring Boot backend.
# Leave empty when the backend serves the frontend or you use a proxy.
# Default used by the app when unset: http://localhost:8091
REACT_APP_API_URL=http://localhost:8091

# OPTIONAL: Google OAuth Client ID (console.cloud.google.com → Credentials).
# If unset, the "Continue with Google" button is hidden and email/password
# sign-in keeps working. Authorized JavaScript origin: http://localhost:3000
REACT_APP_GOOGLE_CLIENT_ID=
